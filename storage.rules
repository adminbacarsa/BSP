rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSystemUserDoc() {
      return isSignedIn()
        && firestore.exists(/databases/(default)/documents/system_users/$(request.auth.uid));
    }

    function systemUserData() {
      return firestore.get(/databases/(default)/documents/system_users/$(request.auth.uid)).data;
    }

    function systemUserRoleLower() {
      return systemUserData().get('role', '').lower();
    }

    function tokenRoleLower() {
      return ('role' in request.auth.token)
        ? request.auth.token.role.lower()
        : '';
    }

    function isPanelTokenType() {
      return isSignedIn() && request.auth.token.type in [
        'SYSTEM', 'system_user', 'SYSTEM_USER', 'system'
      ];
    }

    function isSuperAdminRole(roleLower) {
      return roleLower == 'superadmin'
        || roleLower == 'super_admin'
        || roleLower == 'super admin'
        || roleLower.matches('super[_\\s-]*admin');
    }

    function normalizedTokenRoleUpper() {
      return tokenRoleLower().replace(' ', '_').upper();
    }

    function normalizedSystemRoleUpper() {
      return isSystemUserDoc()
        ? systemUserRoleLower().replace(' ', '_').upper()
        : '';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        isSuperAdminRole(tokenRoleLower())
        || normalizedTokenRoleUpper() == 'SUPERADMIN'
        || normalizedTokenRoleUpper() == 'SUPER_ADMIN'
        || (isSystemUserDoc() && (
          isSuperAdminRole(systemUserRoleLower())
          || normalizedSystemRoleUpper() == 'SUPERADMIN'
          || normalizedSystemRoleUpper() == 'SUPER_ADMIN'
        ))
      );
    }

    function systemUserEmpresaId() {
      return systemUserData().get('empresaId', '');
    }

    function empresaIdsMatch(pathEmpresaId, profileEmpresaId) {
      return pathEmpresaId.lower() == profileEmpresaId.lower();
    }

    function validBackupJsonUpload(fileName) {
      return fileName.matches('.*\\.json$')
        && request.resource.size < 512 * 1024 * 1024
        && (
          request.resource.contentType.matches('application/json.*')
          || request.resource.contentType == 'application/octet-stream'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'binary/octet-stream'
        );
    }

    function canUploadBackupRestore(empresaId) {
      return isSignedIn() && (
        isSuperAdmin()
        || (
          (isSystemUserDoc() || isPanelTokenType()) && (
            empresaIdsMatch(empresaId, systemUserEmpresaId())
            || empresaId == 'platform'
          )
        )
      );
    }

    match /backup-restore/{empresaId}/{jobId}/{fileName} {
      allow write: if canUploadBackupRestore(empresaId) && validBackupJsonUpload(fileName);
      allow read: if canUploadBackupRestore(empresaId);
    }

    match /absences/{userId}/{fileName} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /credenciales/{empDocId}/{fileName} {
      allow read, write: if isSignedIn();
    }

    match /libro_guardia/{objectiveId}/{fileName} {
      allow read, write: if isSignedIn();
    }
  }
}
