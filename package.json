{
  "name": "cronoapp",
  "version": "1.0.0",
  "description": "Monorepositorio para la aplicación de cronogramas. Contiene Frontend (web) y Backend (functions).",
  "main": "index.js",
  "scripts": {
    "postinstall": "npm --prefix apps/web2 install",
    "register:lab-task": "powershell -ExecutionPolicy Bypass -File scripts/register-cosp-lab-scheduled-task.ps1",
    "register:lab-task:system": "powershell -ExecutionPolicy Bypass -File scripts/register-cosp-lab-scheduled-task.ps1 -AtStartupAsSystem",
    "unregister:lab-task": "powershell -ExecutionPolicy Bypass -File scripts/unregister-cosp-lab-scheduled-task.ps1",
    "auto-pull": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/auto-pull-lab.ps1",
    "register:auto-pull-task": "powershell -ExecutionPolicy Bypass -File scripts/register-cosp-auto-pull-task.ps1",
    "register:auto-pull-task:system": "powershell -ExecutionPolicy Bypass -File scripts/register-cosp-auto-pull-task.ps1 -AtStartupAsSystem",
    "unregister:auto-pull-task": "powershell -ExecutionPolicy Bypass -File scripts/unregister-cosp-auto-pull-task.ps1",
    "diagnose:lab": "powershell -ExecutionPolicy Bypass -File scripts/diagnose-cosp-lab.ps1",
    "afip:csr": "powershell -ExecutionPolicy Bypass -File scripts/generate-afip-csr.ps1",
    "afip:secrets": "powershell -ExecutionPolicy Bypass -File scripts/setup-afip-secrets.ps1 -CertDir scripts/afip-csr-20217563519 -Production true",
    "afip:secrets:homo": "powershell -ExecutionPolicy Bypass -File scripts/setup-afip-secrets.ps1 -CertDir scripts/afip-csr-20217563519 -Production false",
    "seed:lab": "node scripts/seed-lab.js",
    "docs:capturas": "node scripts/capture-tutorial-screens.cjs",
    "docs:capturas-flujo": "node scripts/capture-tutorial-flows.cjs",
    "docs:capturas-all": "npm run docs:capturas && npm run docs:capturas-flujo",
    "dev": "npm --prefix apps/web2 run dev",
    "build": "npm --prefix apps/web2 run build",
    "deploy": "node scripts/deploy.js",
    "deploy:here": "node scripts/deploy.js --here",
    "deploy:worktree": "node scripts/deploy-worktree.js",
    "deploy:functions": "node scripts/deploy.js --functions",
    "deploy:rules": "node scripts/deploy.js --rules",
    "deploy:all": "node scripts/deploy.js --all",
    "start": "npm run serve:final",
    "test": "echo \"Error: Los tests se ejecutan en las subcarpetas: npm run test --workspace=functions\" && exit 1",
    "install:all": "npm install --workspaces",
    "dev:backend": "npm run serve --workspace=functions",
    "dev:frontend": "npm run dev --workspace=web",
    "dev:web2": "npm --prefix apps/web2 run dev",
    "dev:mobile": "npm --prefix apps/mobile-guardia run start",
    "mobile:android": "npm --prefix apps/mobile-guardia run android",
    "mobile:ios": "npm --prefix apps/mobile-guardia run ios",
    "serve:final": "node iniciar.js",
    "sync": "node sync_cronoapp.js",
    "watch": "npx nodemon -L --watch apps --ext ts,tsx,js,json --ignore \"**/node_modules/**\" --ignore \"**/.next/**\" --ignore \"**/out/**\" --delay 2 --exec \"node sync_cronoapp.js\"",
    "dev:local": "bash scripts/start-local.sh",
    "dev:local:backup": "bash scripts/start-local.sh",
    "backup:import": "node scripts/import-backup.js",
    "seed:backup": "node scripts/seed-from-backup-file.js",
    "emulator-bridge": "node scripts/emulator-bridge.js",
    "emulators": "node scripts/run-emulators.js",
    "emulators:light": "node scripts/run-emulators.js --without-functions",
    "backup:restore": "node -e \"const fs=require('fs'),path=require('path'),p=path.join(__dirname,'backups');const prev=path.join(p,'previous'),lat=path.join(p,'latest');if(!fs.existsSync(prev)){console.error('No existe backups/previous');process.exit(1);}if(fs.existsSync(lat))fs.rmSync(lat,{recursive:true,force:true});fs.cpSync(prev,lat,{recursive:true});console.log('Restaurado backups/previous -> backups/latest');\"",
    "seed": "node scripts/seed-lab.js",
    "test:migrate-fixes": "node scripts/test-empresa-migrate-fixes.mjs",
    "eval:planning-agent": "node scripts/eval-planning-agent.mjs",
    "eval:guard-capacity": "npx tsx apps/web2/scripts/eval-guard-capacity.ts",
    "eval:custom-cover": "npx tsx apps/web2/scripts/eval-custom-cover-cycle.ts",
    "eval:sla-active-days": "npx tsx apps/web2/scripts/eval-sla-active-days.ts",
    "eval:franco-streak": "npx tsx apps/web2/scripts/eval-franco-streak-guard.ts",
    "eval:objective-roster": "npx tsx apps/web2/scripts/eval-objective-roster.ts",
    "eval:casa-matriz": "npx tsx apps/web2/scripts/eval-casa-matriz-replay.ts",
    "eval:rotative-mtn": "npx tsx apps/web2/scripts/eval-rotative-mtn-cycle.ts",
    "eval:coverage-wisdom": "npx tsx apps/web2/scripts/eval-coverage-wisdom.ts",
    "eval:vplan": "node scripts/eval-vplan.mjs",
    "run:vplan:obrador": "node scripts/run-vplan-local.mjs --emulator",
    "test:vplan-emulator": "node scripts/test-vplan-emulator.mjs",
    "test:planning-agent-emulator": "node scripts/test-planning-agent-emulator.mjs",
    "test:automate-planning-ui": "node scripts/test-automate-planning-ui.mjs",
    "autoplan:real": "node scripts/run-autoplan-real.mjs",
    "seed:planning-demo": "node scripts/seed-planning-demo.mjs",
    "lab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cosp-lab.ps1",
    "lab:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-cosp-lab.ps1 -Restart",
    "stop:lab": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-cosp-lab.ps1",
    "stop:lab:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-cosp-lab.ps1 -All"
  },
  "keywords": [
    "firebase",
    "nestjs",
    "nextjs",
    "typescript",
    "monorepo"
  ],
  "author": "Vale - Senior Tech Lead",
  "license": "ISC",
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "firebase-tools": "^15.0.0",
    "playwright": "^1.49.1"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.6.0",
    "form-data": "^4.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.555.0",
    "pdfkit": "^0.17.2",
    "react-leaflet": "^5.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0"
  }
}
