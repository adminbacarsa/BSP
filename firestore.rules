rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSystemUser() {
      return request.auth != null && (
        request.auth.token.type == 'system_user' ||
        request.auth.token.type == 'SYSTEM' ||
        request.auth.token.type == 'SYSTEM_USER' ||
        request.auth.token.type == 'system'
      );
    }

    function isSystemUserDoc() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/system_users/$(request.auth.uid));
    }

    function isEmployeeClaim() {
      return request.auth != null && (
        request.auth.token.role == 'employee' ||
        request.auth.token.role == 'EMPLOYEE' ||
        request.auth.token.type == 'employee' ||
        request.auth.token.type == 'EMPLOYEE'
      );
    }

    function roleValueIsSuperAdmin(role) {
      return role == 'SuperAdmin' ||
        role == 'SUPERADMIN' ||
        role == 'SUPER_ADMIN' ||
        role == 'SP' ||
        role == 'superadmin';
    }

    function systemUserIsSuperAdmin() {
      return isSystemUserDoc() &&
        roleValueIsSuperAdmin(
          get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.get('role', '')
        );
    }

    function isSuperAdmin() {
      return request.auth != null && (
        roleValueIsSuperAdmin(request.auth.token.role) ||
        systemUserIsSuperAdmin()
      );
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SuperAdmin' ||
        request.auth.token.role == 'SUPERADMIN' ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        request.auth.token.role == 'SP' ||
        request.auth.token.role == 'Manager' ||
        request.auth.token.role == 'MANAGER' ||
        request.auth.token.role == 'Scheduler' ||
        request.auth.token.role == 'SCHEDULER' ||
        request.auth.token.role == 'Supervisor' ||
        request.auth.token.role == 'SUPERVISOR' ||
        request.auth.token.role == 'Operator' ||
        request.auth.token.role == 'OPERATOR' ||
        request.auth.token.role == 'HR_Manager' ||
        request.auth.token.role == 'HR_MANAGER' ||
        isSystemUser() ||
        isSystemUserDoc() ||
        !isEmployeeClaim()
      );
    }

    function isClientUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/client_users/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function empleadoAuthDocExists() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/empleados/$(request.auth.uid));
    }

    function empleadoAuthDocEmpresaId() {
      return empleadoAuthDocExists()
        ? get(/databases/$(database)/documents/empleados/$(request.auth.uid)).data.empresaId
        : '';
    }

    function userEmpresaId() {
      return isSystemUserDoc()
        ? get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.get('empresaId', '')
        : '';
    }

    // Empresa del token Auth (empleados portal) o system_users (admins).
    function authEmpresaId() {
      return request.auth != null && request.auth.token.empresaId is string
        ? request.auth.token.empresaId
        : userEmpresaId();
    }

    // Tenant para portal guardia: claim empresaId en el JWT.
    function employeeTenantMatches(data) {
      return isEmployeeClaim() && authEmpresaId() != '' && (
        docEmpresaId(data) == authEmpresaId() ||
        (authEmpresaId() == 'bacarsa' && (docEmpresaId(data) == '' || docEmpresaId(data) == 'bacarsa'))
      );
    }

    function empleadoEmpresaId(empleadoId) {
      return exists(/databases/$(database)/documents/empleados/$(empleadoId))
        ? get(/databases/$(database)/documents/empleados/$(empleadoId)).data.get('empresaId', '')
        : '';
    }

    function systemUserHasAllEmpresas() {
      return isSystemUserDoc() &&
        get(/databases/$(database)/documents/system_users/$(request.auth.uid)).data.get('allEmpresas', false) == true;
    }

    function bacarsaLegacyOpen() {
      return userEmpresaId() == 'bacarsa' &&
        exists(/databases/$(database)/documents/empresas/bacarsa) &&
        get(/databases/$(database)/documents/empresas/bacarsa).data.get('migracionCompleta', false) != true;
    }

    function docEmpresaId(data) {
      return data.get('empresaId', '');
    }

    // Bacarsa: docs sin empresaId o con empresaId=bacarsa (aunque migracionCompleta esté en true).
    function bacarsaTenantDocMatches(data) {
      return userEmpresaId() == 'bacarsa' && (
        docEmpresaId(data) == '' || docEmpresaId(data) == 'bacarsa'
      );
    }

    function tenantMatches(data) {
      return isSuperAdmin() || systemUserHasAllEmpresas() || (
        userEmpresaId() != '' && (
          docEmpresaId(data) == userEmpresaId() ||
          bacarsaTenantDocMatches(data) ||
          (bacarsaLegacyOpen() && userEmpresaId() == 'bacarsa' && docEmpresaId(data) == '')
        )
      );
    }

    function systemUserVisibleToAdmin(data) {
      return roleValueIsSuperAdmin(data.get('role', '')) ||
        data.get('allEmpresas', false) == true ||
        tenantMatches(data);
    }

    function tenantAdminRead() {
      return isSuperAdmin() || (isAdmin() && tenantMatches(resource.data));
    }

    function tenantAdminCreate() {
      return isSuperAdmin() || (isAdmin() && tenantMatches(request.resource.data));
    }

    function tenantAdminUpdate() {
      return isSuperAdmin() || (isAdmin() && (
        tenantMatches(resource.data) && tenantMatches(request.resource.data)
      ));
    }

    function tenantAdminDelete() {
      return isSuperAdmin() || (isAdmin() && tenantMatches(resource.data));
    }

    // Admins de empresa pueden adoptar docs legacy de planificación sin empresaId
    // (asignación de puestos / estados mensuales) sellando su tenant.
    function planificacionEstadoClaimTenant() {
      return isAdmin() && userEmpresaId() != '' &&
        docEmpresaId(resource.data) == '' &&
        docEmpresaId(request.resource.data) == userEmpresaId();
    }

    function clientUserClientId() {
      return isClientUser()
        ? get(/databases/$(database)/documents/client_users/$(request.auth.uid)).data.get('clientId', '')
        : '';
    }

    function clientUserEmpresaId() {
      return isClientUser()
        ? get(/databases/$(database)/documents/client_users/$(request.auth.uid)).data.get('empresaId', '')
        : '';
    }

    // Turno legible por usuario de portal: pertenece a su cliente.
    function clientUserMatchesTurno(data) {
      return isClientUser() && clientUserClientId() != '' && clientUserClientId() == data.get('clientId', '');
    }

    // Empleado legible por usuario de portal: misma empresa (para mostrar nombres en "agregar turno").
    function clientUserMatchesEmpleado(data) {
      return isClientUser() && clientUserEmpresaId() != '' && data.get('empresaId', '') == clientUserEmpresaId();
    }

    function clientUserMatchesSolicitud(data) {
      return isClientUser() && clientUserClientId() == data.get('clientId', '');
    }

    function clientUserCanCreateSolicitud(data) {
      return isClientUser() && clientUserClientId() == data.get('clientId', '');
    }

    function feriadoReadable(data) {
      return isSuperAdmin() || docEmpresaId(data) == '' || tenantMatches(data);
    }

    function empleadoDocOwnedByAuth(empleadoId) {
      return request.auth != null && (
        empleadoId == request.auth.uid ||
        (exists(/databases/$(database)/documents/empleados/$(empleadoId)) &&
         get(/databases/$(database)/documents/empleados/$(empleadoId)).data.get('uid', '') == request.auth.uid)
      );
    }

    // Portal guardia: hero e historial leen turnos con where employeeId == legajo o uid.
    // Alertas no leen turnos (user_notifications). client_users siguen por clientId.
    function employeeReadsOwnTurno(data) {
      return request.auth != null
        && data.get('employeeId', '') != ''
        && empleadoDocOwnedByAuth(data.get('employeeId', ''));
    }

    function eventoActivoReadable(data) {
      return data.status == 'activo' || data.status == 'abierto' || data.status == 'en_curso';
    }

    function roleReadable(data) {
      return isSuperAdmin() || docEmpresaId(data) == '' || docEmpresaId(data) == userEmpresaId();
    }

    function roleWritable(data) {
      return isSuperAdmin() || (docEmpresaId(data) == userEmpresaId() && userEmpresaId() != '');
    }

    // Cierres automáticos que P1 sacó del navegador: hoy los escribe solo el server
    // (autoCompletarTurnos / registrarPresencia, Admin SDK, que no pasa por reglas).
    // Una pestaña vieja sin recargar seguiría cerrando turnos con estos motivos.
    function retiredFrontCloseReasons() {
      return [
        'AUTO_SHIFT_END',
        'AUTO_SHIFT_END_CUSTOM',
        'AUTO_ZOMBIE_SHIFT_END',
        'AUTO_ZOMBIE_12H',
        'AUTO_COVERAGE_COMPLETE',
        'AUTO_OVERTIME_LIMIT',
        'AUTO_MANUAL_RETENTION_END',
        'AUTO_END_CF_RETENTION_TIMEOUT'
      ];
    }

    function noRetiredCloseReasonCreate() {
      return !(request.resource.data.get('completionReason', '') in retiredFrontCloseReasons())
        && !(request.resource.data.get('autoCloseReason', '') in retiredFrontCloseReasons());
    }

    // Solo mira los campos que trae la escritura: cualquier otra actualización del turno
    // (cierre manual del CC, fichada del guardia) pasa igual, aunque el documento ya
    // guarde un motivo retirado de un cierre viejo.
    function noRetiredCloseReasonUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return (!changed.hasAny(['completionReason'])
          || !(request.resource.data.get('completionReason', '') in retiredFrontCloseReasons()))
        && (!changed.hasAny(['autoCloseReason'])
          || !(request.resource.data.get('autoCloseReason', '') in retiredFrontCloseReasons()));
    }

    match /turnos/{shiftId} {
      allow read: if tenantAdminRead()
        || employeeReadsOwnTurno(resource.data)
        || clientUserMatchesTurno(resource.data);
      allow create: if tenantAdminCreate() && noRetiredCloseReasonCreate();
      allow update: if tenantAdminUpdate() && noRetiredCloseReasonUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /empleados/{employeeId} {
      allow read: if tenantAdminRead()
        || (request.auth != null && !isAdmin())
        || clientUserMatchesEmpleado(resource.data);
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate() || request.auth != null;
      allow delete: if tenantAdminDelete();
    }

    match /ausencias/{absenceId} {
      allow read: if tenantAdminRead() || request.auth != null;
      allow create: if tenantAdminCreate() || request.auth != null;
      allow update: if tenantAdminUpdate() || request.auth != null;
      allow delete: if tenantAdminDelete();
    }

    match /objetivos/{objectiveId} {
      allow read: if tenantAdminRead() || (request.auth != null && !isAdmin());
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /clientes/{clientId} {
      allow read: if tenantAdminRead() || (request.auth != null && !isAdmin());
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /clients/{clientId} {
      allow read: if tenantAdminRead()
        || (request.auth != null && !isAdmin())
        || (isClientUser() && clientUserClientId() == clientId);
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      // Baja normal = update status INACTIVE. El documento solo lo borra SuperAdmin,
      // y la app lo rechaza si hay turnos, servicios_sla u ordenes_compra.
      allow delete: if isSuperAdmin();
    }

    match /contracts/{contractId} {
      allow read: if tenantAdminRead() || isAdmin();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /quotes/{quoteId} {
      allow read: if tenantAdminRead() || isAdmin();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /contratos_servicio/{contractId} {
      allow read: if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /tipos_turno/{typeId} {
      allow read: if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    // Catálogo de tipos de novedad RRHH (parametrizable por empresa). Soft delete vía status.
    match /tipos_novedad/{typeId} {
      allow read: if tenantAdminRead() || isAdmin();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if false;
    }

    match /servicios_sla/{slaId} {
      allow read: if isSuperAdmin() || tenantAdminRead() || request.auth != null;
      allow create: if tenantAdminCreate();
      // Contrato cerrado (vencido): solo lectura salvo SuperAdmin; reapertura por callable reabrirContratoSla.
      allow update: if tenantAdminUpdate()
        && (resource.data.get('closed', false) != true || isSuperAdmin());
      allow delete: if tenantAdminDelete();
    }

    // Órdenes de compra de prefactura (cliente externo). Query: empresaId + clientId.
    match /ordenes_compra/{id} {
      allow read: if tenantAdminRead() || isSuperAdmin();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /planificacion_estados/{docId} {
      allow read: if tenantAdminRead() || request.auth != null;
      // Asignación de puestos / estado mensual: admin autenticado con empresa sellada.
      // Docs legacy sin empresaId se pueden adoptar sellando el tenant del usuario.
      allow create: if isSuperAdmin() || systemUserHasAllEmpresas() || (
        isAdmin() && userEmpresaId() != '' && (
          docEmpresaId(request.resource.data) == userEmpresaId() ||
          (userEmpresaId() == 'bacarsa' && (
            docEmpresaId(request.resource.data) == '' ||
            docEmpresaId(request.resource.data) == 'bacarsa'
          ))
        )
      );
      allow update: if isSuperAdmin() || systemUserHasAllEmpresas() || (
        isAdmin() && userEmpresaId() != '' && (
          docEmpresaId(request.resource.data) == userEmpresaId() ||
          (userEmpresaId() == 'bacarsa' && (
            docEmpresaId(request.resource.data) == '' ||
            docEmpresaId(request.resource.data) == 'bacarsa'
          ))
        ) && (
          tenantMatches(resource.data) ||
          docEmpresaId(resource.data) == '' ||
          bacarsaTenantDocMatches(resource.data)
        )
      );
      allow delete: if tenantAdminDelete();
    }

    match /planning_rules/{empresaId} {
      allow read: if isAdmin() && (isSuperAdmin() || empresaId == userEmpresaId());
      allow write: if isSuperAdmin() || (
        isAdmin() && empresaId == userEmpresaId()
      );
    }

    match /empresas/{empresaId} {
      allow read: if isAdmin() || isEmployeeClaim();
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (
        isAdmin() && empresaId == userEmpresaId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avisos'])
      );
    }

    // PEM AFIP: solo Cloud Functions (Admin SDK). Metadatos públicos en empresas.{afipConfigured,...}
    match /empresa_afip_credentials/{empresaId} {
      allow read, write: if false;
    }

    match /roles/{roleId} {
      allow read: if isAdmin() && (isSuperAdmin() || roleReadable(resource.data));
      allow create: if isSuperAdmin() || (
        isAdmin() && docEmpresaId(request.resource.data) == userEmpresaId() && userEmpresaId() != ''
      );
      allow update, delete: if isSuperAdmin() || (
        isAdmin() && roleWritable(resource.data) && roleWritable(request.resource.data)
      );
    }

    match /feriados/{holidayId} {
      allow read: if request.auth != null && (isAdmin() ? feriadoReadable(resource.data) : true);
      allow create: if isSuperAdmin() || (
        isAdmin() && (
          docEmpresaId(request.resource.data) == '' ||
          docEmpresaId(request.resource.data) == userEmpresaId()
        )
      );
      allow update, delete: if isSuperAdmin() || (
        isAdmin() && feriadoReadable(resource.data) && (
          docEmpresaId(request.resource.data) == '' ||
          docEmpresaId(request.resource.data) == userEmpresaId()
        )
      );
    }

    match /system_users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin() || (
        isAdmin() && systemUserVisibleToAdmin(resource.data)
      );
      allow create, update, delete: if isSuperAdmin();
    }

    function deviceTokenBindingFieldsPresent(data) {
      return data.keys().hasAny(['verified', 'deviceId', 'retiredDeviceIds']);
    }

    match /device_tokens/{tokenId} {
      function clientFcmDeviceTokenWriteOk() {
        return request.auth != null
          && tokenId != request.auth.uid
          && request.resource.data.get('uid', '') == request.auth.uid;
      }

      function deviceTokenFcmEmployeeIdOk(data) {
        return !data.keys().hasAny(['employeeId'])
          || empleadoDocOwnedByAuth(data.get('employeeId', ''))
          || isSuperAdmin();
      }

      function deviceTokenFcmRoleOk(data) {
        return !data.keys().hasAny(['role'])
          || isSuperAdmin()
          || (isEmployeeClaim() && data.get('role', '') == 'employee')
          || (isAdmin() && (data.get('role', '') == 'admin' || data.get('role', '') == 'employee'));
      }

      function deviceTokenFcmEmpresaIdOk(data) {
        return !data.keys().hasAny(['empresaId'])
          || data.get('empresaId', null) == null
          || (isSuperAdmin())
          || (isAdmin() && (
            data.get('empresaId', '') == authEmpresaId()
            || authEmpresaId() == ''
            || systemUserHasAllEmpresas()
          ))
          || (isEmployeeClaim() && data.get('empresaId', '') == authEmpresaId());
      }

      function deviceTokenFcmMetadataOk(data) {
        return deviceTokenFcmEmployeeIdOk(data)
          && deviceTokenFcmRoleOk(data)
          && deviceTokenFcmEmpresaIdOk(data);
      }

      // Doc vínculo device_tokens/{uid}: solo Admin SDK (bindGuardDevice, activaciones, approve/unbind).
      // Docs FCM (tokenId != uid): el cliente registra push sin tocar verified/deviceId/retiredDeviceIds.
      allow read: if isAdmin() || (request.auth != null && tokenId == request.auth.uid);

      allow create: if clientFcmDeviceTokenWriteOk()
        && !deviceTokenBindingFieldsPresent(request.resource.data)
        && deviceTokenFcmMetadataOk(request.resource.data);

      allow update: if clientFcmDeviceTokenWriteOk()
        && resource.data.get('uid', '') == request.auth.uid
        && !deviceTokenBindingFieldsPresent(request.resource.data)
        && deviceTokenFcmMetadataOk(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'deviceId', 'retiredDeviceIds']);

      allow delete: if request.auth != null
        && tokenId != request.auth.uid
        && resource.data.get('uid', '') == request.auth.uid;
    }

    match /device_bindings/{deviceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /user_notifications/{notifId} {
      // Empleado: solo propias (uid o legajo con su uid). Admin: tenant.
      allow read: if request.auth != null && (
        isAdmin()
          ? tenantAdminRead()
          : (
            resource.data.uid == request.auth.uid
            || (
              resource.data.employeeId is string
              && exists(/databases/$(database)/documents/empleados/$(resource.data.employeeId))
              && get(/databases/$(database)/documents/empleados/$(resource.data.employeeId)).data.uid == request.auth.uid
            )
          )
      );
      // Lectura/acuse/ocultar propia; no borrar físico
      allow update: if request.auth != null && (
        isAdmin()
        || resource.data.uid == request.auth.uid
        || (
          resource.data.employeeId is string
          && exists(/databases/$(database)/documents/empleados/$(resource.data.employeeId))
          && get(/databases/$(database)/documents/empleados/$(resource.data.employeeId)).data.uid == request.auth.uid
        )
      );
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // Digests de push planificación: solo Admin SDK / Functions
    match /shift_notif_digests/{digestId} {
      allow read, write: if false;
    }

    match /swap_requests/{requestId} {
      allow read: if tenantAdminRead() || request.auth != null;
      allow create: if tenantAdminCreate() || request.auth != null;
      allow update: if tenantAdminUpdate() || (
        request.auth != null && (
          resource.data.requesterId == request.auth.uid ||
          resource.data.targetId == request.auth.uid
        )
      );
      allow delete: if tenantAdminDelete();
    }

    match /novedades/{novedadId} {
      allow read: if request.auth != null && (isAdmin() ? tenantAdminRead() : true);
      allow create: if request.auth != null && (isAdmin() ? tenantAdminCreate() : true);
      allow update: if tenantAdminUpdate() || (
        request.auth != null && isAdmin() && tenantMatches(resource.data)
      );
      allow delete: if tenantAdminDelete();
    }

    match /audit_logs/{logId} {
      allow read: if request.auth != null && (isAdmin() ? tenantAdminRead() : true);
      allow create: if request.auth != null && (isAdmin() ? tenantAdminCreate() : true);
      allow update, delete: if tenantAdminDelete();
    }

    match /device_activations/{tokenId} {
      // Solo Functions (server-side) escribe; el empleado puede leer el suyo para debug
      allow read: if isSuperAdmin() || isAdmin();
      allow write: if false;
    }

    match /credenciales_publicas/{credId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /libro_guardia/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    match /personal_autorizado/{docId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || isClientUser();
      allow update, delete: if isAdmin() || isClientUser();
    }

    match /client_users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId)
        || isSuperAdmin()
        || (isAdmin() && tenantMatches(resource.data));
      allow write: if isSuperAdmin() || isAdmin();
    }

    match /visitas_programadas/{visitaId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin() || isClientUser();
    }

    match /assistant_interaction_logs/{logId} {
      allow read: if isSuperAdmin() || (isAdmin() && tenantAdminRead());
      allow create, update, delete: if false;
    }

    match /system_backups/{backupId} {
      allow read: if isSuperAdmin() || (isAdmin() && tenantMatches(resource.data));
      allow create: if isSuperAdmin() || (isAdmin() && tenantMatches(request.resource.data));
      allow update, delete: if isSuperAdmin() || (isAdmin() && tenantMatches(resource.data));
    }

    match /system_config/{docId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /system_secrets/{docId} {
      allow read, write: if false;
    }

    match /scheduled_job_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /backup_jobs/{jobId} {
      allow read: if isSuperAdmin() || (isAdmin() && resource.data.empresaId == userEmpresaId());
      allow write: if false;
    }

    match /restore_jobs/{jobId} {
      allow read: if isSuperAdmin() || (
        isAdmin() && resource.data.requestedBy == request.auth.uid
      );
      allow write: if false;
    }

    match /empresa_migrate_jobs/{jobId} {
      allow read: if isSuperAdmin() || (
        isAdmin() && resource.data.requestedBy == request.auth.uid
      );
      allow write: if false;
    }

    match /planificaciones_historial/{docId} {
      allow read, write: if isAdmin();
    }

    match /historial_operaciones/{docId} {
      allow read, write: if isAdmin();
    }

    match /convenios_colectivos/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    match /platform_credentials/{docId} {
      allow read, write: if isSuperAdmin();
    }

    match /ajustes_horas/{docId} {
      allow read:   if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /ajustes_crono/{docId} {
      allow read:   if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /solicitudes_refuerzo/{docId} {
      // Admin y supervisores leen/escriben por empresa
      allow read:   if tenantAdminRead() || clientUserMatchesSolicitud(resource.data);
      allow create: if tenantAdminCreate() || clientUserCanCreateSolicitud(request.resource.data);
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /sesiones_operador/{sessionId} {
      allow read: if request.auth != null && isAdmin() && tenantAdminRead();
      allow create: if request.auth != null && isAdmin() && tenantAdminCreate()
        && request.resource.data.operatorId == request.auth.uid
        && request.resource.data.status == 'ACTIVO';
      // Sala multi-operador: cualquier admin del tenant puede actualizar
      // (transferir piloto, cerrar sala → Auto, reconciliar roles).
      allow update: if request.auth != null && isAdmin() && tenantMatches(resource.data);
      allow delete: if tenantAdminDelete();
    }

    // Fichajes: solo Cloud Functions escriben; admin/empleado pueden leer los propios
    match /fichajes/{fichajeId} {
      allow read: if tenantAdminRead();
      allow write: if false;
    }

    // Agregados de liquidación mensual (pre-calculados server-side)
    match /liquidacion_mensual/{docId} {
      allow read: if tenantAdminRead();
      allow write: if false;
      match /empleados/{empId} {
        allow read: if tenantAdminRead();
        allow write: if false;
      }
    }

    match /liquidacion_turno_contrib/{turnoId} {
      allow read: if tenantAdminRead();
      allow write: if false;
    }

    match /supervision_visitas/{docId} {
      allow read: if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /objetivo_consignas/{docId} {
      allow read: if request.auth != null;
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    match /objetivo_consigna_lecturas/{docId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.userUid == request.auth.uid;
      allow delete: if tenantAdminDelete();
    }

    match /crm_metrics_snapshot/{docId} {
      allow read:   if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    // Extracto mensual SLA / plan / real (cuenta corriente de horas).
    match /hours_balances/{docId} {
      allow read:   if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    // Libro de horas (H2a). Escritura solo Admin SDK. No reemplaza hours_balances hasta H2b.
    // Lectura: admin del tenant. Las reglas de este repo no leen roles/{id}.permissions, así que el
    // permiso del módulo HOURS_BANK se aplica en la app y en el callable rebuildHoursLedger.
    match /hours_ledger/{docId} {
      allow read: if tenantAdminRead();
      allow write: if false;
    }
    match /hours_ledger_monthly/{docId} {
      allow read: if tenantAdminRead();
      allow write: if false;
    }
    // H2f. Escritura solo Admin SDK. La lectura permite «Actualizando…» en Banco de Horas.
    match /hours_ledger_dirty/{docId} {
      allow read: if tenantAdminRead();
      allow write: if false;
    }
    match /hours_ledger_jobs/{jobId} {
      allow read: if tenantAdminRead();
      allow write: if false;
      match /slices/{sliceId} {
        allow read: if tenantAdminRead();
        allow write: if false;
      }
    }

    match /grupos_objetivos/{grupoId} {
      allow read:   if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    // Correcciones manuales de liquidación por ciclo y empleado.
    match /ajustes_liquidacion/{docId} {
      allow read:   if tenantAdminRead();
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    // Modo de horas publicado al endpoint de liquidación (planned | real).
    match /payroll_settings/{empId} {
      allow read: if isSuperAdmin() || systemUserHasAllEmpresas() || (
        isAdmin() && userEmpresaId() != '' && empId == userEmpresaId()
      );
      allow create, update: if isSuperAdmin() || systemUserHasAllEmpresas() || (
        isAdmin() && userEmpresaId() != '' && empId == userEmpresaId()
        && request.resource.data.empresaId == empId
      );
      allow delete: if tenantAdminDelete();
    }

    // Mapeo centros de costo (Excel marcaciones) → objetivos CRM por empresa.
    // Doc id = empresaId; el campo empresaId debe coincidir.
    match /ccosto_objective_mapping/{empId} {
      allow read: if isSuperAdmin() || systemUserHasAllEmpresas() || (
        isAdmin() && userEmpresaId() != '' && empId == userEmpresaId()
      ) || (
        isAdmin() && resource != null && tenantMatches(resource.data)
      );
      allow create, update: if isSuperAdmin() || systemUserHasAllEmpresas() || (
        isAdmin() && userEmpresaId() != '' && empId == userEmpresaId()
        && request.resource.data.empresaId == empId
      ) || (
        isAdmin() && request.resource.data.empresaId == empId
        && tenantMatches(request.resource.data)
      );
      allow delete: if isSuperAdmin() || tenantAdminDelete();
    }

    // API Keys de integraciones — solo lectura de metadata (no del hash).
    // Escritura exclusivamente vía Admin SDK (callables createPayrollApiKey / revokePayrollApiKey).
    match /integrity_reports/{reportId} {
      allow read: if isSuperAdmin() || (isAdmin() && tenantMatches(resource.data));
      allow write: if false;
    }

    match /integraciones_api/{keyId} {
      allow read:  if isSuperAdmin() || (isAdmin() && tenantMatches(resource.data));
      allow write: if false;
    }

    match /eventos/{eventoId} {
      allow read:   if tenantAdminRead()
                       || (employeeTenantMatches(resource.data) && eventoActivoReadable(resource.data));
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate();
      allow delete: if tenantAdminDelete();
    }

    // Solicitudes de guardia para trabajar en un servicio de evento.
    // El guardia puede crear y leer las propias; el admin responde.
    match /solicitudes_evento/{solicitudId} {
      allow read:   if tenantAdminRead() || empleadoDocOwnedByAuth(resource.data.empleadoId);
      allow create: if tenantAdminCreate()
                       || (isEmployeeClaim()
                           && empleadoDocOwnedByAuth(request.resource.data.empleadoId)
                           && request.resource.data.empresaId == empleadoEmpresaId(request.resource.data.empleadoId));
      allow update: if tenantAdminUpdate()
                       || empleadoDocOwnedByAuth(resource.data.empleadoId);
      allow delete: if tenantAdminDelete();
    }

    // Convocatorias de cobertura operativa (cascada CCT).
    // Admin: CRUD completo del tenant. Empleado: lee y actualiza la suya para responder.
    match /convocatorias_cobertura/{convId} {
      allow read:   if tenantAdminRead() || empleadoDocOwnedByAuth(resource.data.candidateEmployeeId);
      allow create: if tenantAdminCreate();
      allow update: if tenantAdminUpdate() || empleadoDocOwnedByAuth(resource.data.candidateEmployeeId);
      allow delete: if tenantAdminDelete();

      match /eventos/{eventId} {
        allow read: if tenantAdminRead();
        allow write: if false;
      }
    }

    function contratoEventualCausaOk(data) {
      return data.get('causa', '') is string && data.get('causa', '').size() > 0;
    }

    // Bolsa del grupo (una persona por CUIL). Lectura: admin del panel.
    // Escritura: SuperAdmin o Admin SDK. No se borra desde el cliente. Las publica Claude.
    match /eventuales_bolsa/{cuil} {
      allow read: if isSuperAdmin() || isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /grupos_eventuales/{grupoId} {
      allow read: if isSuperAdmin() || isAdmin();
      allow write: if isSuperAdmin();
    }

    // Envíos de carga masiva ARCA. El TXT y el token no se leen desde el cliente:
    // el robot y la página del link pasan por la función `arcaEnviosApi` (Admin SDK).
    match /arca_envios/{envioId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Escala CCT por vigencia. Historial = un doc por vigenciaDesde. Escritura: SuperAdmin. Las publica Claude.
    match /escalas_salariales/{escalaId} {
      allow read: if isSuperAdmin() || isAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /contratos_eventuales/{contratoId} {
      allow read: if tenantAdminRead() || empleadoDocOwnedByAuth(resource.data.employeeId);
      allow create: if tenantAdminCreate()
        && contratoEventualCausaOk(request.resource.data)
        && request.resource.data.estado == 'BORRADOR';
      allow update: if tenantAdminUpdate()
        && contratoEventualCausaOk(request.resource.data)
        && request.resource.data.estado == resource.data.estado
        && request.resource.data.get('documento', null) == resource.data.get('documento', null)
        && request.resource.data.get('acuse', null) == resource.data.get('acuse', null)
        && request.resource.data.get('arca', null) == resource.data.get('arca', null);
      allow delete: if tenantAdminDelete();
    }

    // Sesiones de capacitación sandbox (training_sessions).
    // Doc id = {empresaId}_{userId}. El alumno (admin de empresa capacitación) lee y escribe la propia.
    match /training_sessions/{sessionId} {
      allow read:   if tenantAdminRead()
                       || (isAdmin() && request.auth != null
                           && sessionId == (userEmpresaId() + '_' + request.auth.uid));
      allow create: if tenantAdminCreate()
                       || (isAdmin() && request.auth != null
                           && sessionId == (request.resource.data.empresaId + '_' + request.auth.uid)
                           && request.resource.data.empresaId == userEmpresaId());
      allow update: if tenantAdminUpdate()
                       || (isAdmin() && request.auth != null
                           && sessionId == (resource.data.empresaId + '_' + request.auth.uid));
      allow delete: if tenantAdminDelete();
    }
  }
}
