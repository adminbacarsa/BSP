rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSystemUser() {
      return request.auth != null && (
        request.auth.token.type == 'system_user' ||
        request.auth.token.type == 'SYSTEM' ||
        request.auth.token.type == 'SYSTEM_USER' ||
        request.auth.token.type == 'system'
      );
    }

    function isSystemUserDoc() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/system_users/$(request.auth.uid));
    }

    function isEmployeeClaim() {
      return request.auth != null && (
        request.auth.token.role == 'employee' ||
        request.auth.token.role == 'EMPLOYEE' ||
        request.auth.token.type == 'employee' ||
        request.auth.token.type == 'EMPLOYEE'
      );
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'Admin' ||
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.role == 'SuperAdmin' ||
        request.auth.token.role == 'SUPERADMIN' ||
        request.auth.token.role == 'Manager' ||
        request.auth.token.role == 'MANAGER' ||
        request.auth.token.role == 'Scheduler' ||
        request.auth.token.role == 'SCHEDULER' ||
        request.auth.token.role == 'Supervisor' ||
        request.auth.token.role == 'SUPERVISOR' ||
        request.auth.token.role == 'Operator' ||
        request.auth.token.role == 'OPERATOR' ||
        request.auth.token.role == 'HR_Manager' ||
        request.auth.token.role == 'HR_MANAGER' ||
        isSystemUser() ||
        isSystemUserDoc() ||
        !isEmployeeClaim()
      );
    }

    function isClientUser() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/client_users/$(request.auth.uid));
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Acceso global para admins
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // 1. Turnos — empleados pueden leer cualquier turno (la query filtra por employeeId)
    match /turnos/{shiftId} {
      allow read: if isAdmin() || request.auth != null;
      allow write: if isAdmin();
    }

    // 2. Empleados
    match /empleados/{employeeId} {
      allow read, write: if isAdmin();
      // Empleados autenticados pueden leer su propio doc (por cualquier método de búsqueda)
      allow read: if request.auth != null;
    }

    // 3. Ausencias
    match /ausencias/{absenceId} {
      allow read, write: if isAdmin();
      allow read, create: if request.auth != null;
    }

    // 4. Objetivos — empleados necesitan leer para check-in y cronograma
    match /objetivos/{objectiveId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /clientes/{clientId} {
      allow read, write: if isAdmin();
      // Empleados necesitan leer clientes para resolver nombres de objetivos
      allow read: if request.auth != null;
    }
    match /clients/{clientId} {
      allow read, write: if isAdmin();
      // Empleados necesitan leer clients para resolver nombres de objetivos
      allow read: if request.auth != null;
    }
    match /contratos_servicio/{contractId} {
      allow read, write: if isAdmin();
    }
    match /tipos_turno/{typeId} {
      allow read, write: if isAdmin();
    }
    match /servicios_sla/{slaId} {
      allow read, write: if isAdmin();
    }

    // 5. Usuarios del Sistema
    match /system_users/{userId} {
      // Lectura propia: necesaria para firestore.get() en reglas de Storage (backup upload)
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // 6. Tokens de dispositivos
    match /device_tokens/{tokenId} {
      allow create, update, delete: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
    }

    // 7. Notificaciones de usuario
    // El get() cross-documento rompe las queries de colección en Firestore Rules.
    // Solución: cualquier usuario autenticado puede leer/marcar sus notificaciones
    // (la seguridad real está en la query: where('uid') o where('employeeId')).
    match /user_notifications/{notifId} {
      allow read, update: if request.auth != null;
      allow create: if false;
      allow delete: if isAdmin();
    }

    // 8. Solicitudes de intercambio — empleados pueden leer y crear las propias
    match /swap_requests/{requestId} {
      allow read, write: if isAdmin();
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.requesterId == request.auth.uid ||
        resource.data.targetId == request.auth.uid
      );
    }

    // 9. Novedades
    match /novedades/{novedadId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 10. Bitácora
    match /audit_logs/{logId} {
      allow read, create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 11. Credenciales públicas — lectura sin auth para verificación por QR
    match /credenciales_publicas/{credId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 12. Libro de guardia — empleados leen/crean entradas de sus objetivos
    match /libro_guardia/{entryId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 13. Personal autorizado por objetivo — admins y usuarios de portal cliente gestionan
    match /personal_autorizado/{docId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || isClientUser();
      allow update, delete: if isAdmin() || isClientUser();
    }

    // 14. Usuarios del portal de clientes
    match /client_users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // 15. Visitas programadas — el cliente agenda sus visitas anticipadas
    match /visitas_programadas/{visitaId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin() || isClientUser();
    }

    // 16. Log del asistente IA (solo escritura desde Cloud Functions)
    match /assistant_interaction_logs/{logId} {
      allow read: if isAdmin() || isSystemUserDoc();
      allow create, update, delete: if false;
    }
  }
}
