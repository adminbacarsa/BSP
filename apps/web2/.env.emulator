# Modo emulador local — copiar a .env.local para activar
# NO commitear este archivo con credenciales reales

NEXT_PUBLIC_USE_EMULATOR=true
# Solo si el front y los emuladores están en PCs distintos. Si abres el front por la misma IP
# que el dev server (p. ej. http://192.168.0.x:3000), no hace falta: se usa el host de la URL.
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.0.XXX

# Credenciales reales del proyecto — el SDK las usa para inicializar,
