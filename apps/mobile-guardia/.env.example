# Copiar a .env en esta carpeta. No commitear .env.
# Mismas credenciales públicas que apps/web2/.env.local (proyecto comtroldata).

# true = emuladores locales (Auth :9099, Firestore :8080, Functions :5001)
EXPO_PUBLIC_USE_EMULATOR=true

# IP de la PC donde corren los emuladores (obligatorio en dispositivo físico; en emulador Android puede ser 10.0.2.2)
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=comtroldata
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
