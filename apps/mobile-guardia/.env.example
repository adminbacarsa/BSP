# Copiar a .env en esta carpeta. No commitear .env.
# Mismas credenciales públicas que apps/web2/.env.local (proyecto comtroldata).

# true = emuladores locales (Auth :9099, Firestore :8080, Functions :5001)
EXPO_PUBLIC_USE_EMULATOR=true

# Web en la notebook: Firestore usa 127.0.0.1 automáticamente (no hace falta cambiar esto).
# Celular físico: IP IPv4 Wi‑Fi de la PC (ipconfig), ej. 192.168.0.49
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=192.168.0.49

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=comtroldata
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL pública del portal (QR credencial). Producción: https://comtroldata.web.app
EXPO_PUBLIC_PORTAL_WEB_ORIGIN=https://comtroldata.web.app

# Deep link preview SuperAdmin (opcional). Producción APK: cosp-guardia://preview
# Expo Go dev (misma IP que dev:mobile): exp://192.168.0.49:8081/--/preview
# EXPO_PUBLIC_MOBILE_PREVIEW_LINK_BASE=cosp-guardia://preview

# Push FCM (build nativo): descargar google-services.json desde Firebase Console
# (app Android com.grupobacar.cosp.guardia) y colocarlo en apps/mobile-guardia/
# antes de `eas build`. Expo Go en Android no entrega token FCM de producción.
