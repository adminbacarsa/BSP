# GMAIL_PASS debe ser una "Contraseña de aplicación" de Google, NO la contraseña normal.
# Ver instrucciones: https://myaccount.google.com/apppasswords

GMAIL_USER=tu-cuenta@gmail.com
GMAIL_PASS=xxxx-xxxx-xxxx-xxxx
