# Asistente COSP + IA planificación (obligatorio en emulador de Functions)
GEMINI_API_KEY=your-key-here

# Mails del sistema (portal empleados, portal clientes, código de anexo).
# Remitente por defecto: COSP <cosp@bacarsa.com.ar> (MAIL_FROM lo cambia).
# MAIL_PASS es la clave de aplicación de cosp@bacarsa.com.ar, no la contraseña de la casilla.
# Se genera en https://myaccount.google.com/apppasswords (la cuenta tiene que tener verificación en 2 pasos).
# No commitear este archivo con la clave real: copiarlo a apps/functions/.env
MAIL_USER=cosp@bacarsa.com.ar
MAIL_PASS=xxxx-xxxx-xxxx-xxxx
# MAIL_FROM=COSP <cosp@bacarsa.com.ar>
# Hasta cargar MAIL_USER / MAIL_PASS siguen valiendo GMAIL_USER / GMAIL_PASS.

# Consulta padrón AFIP (CRM — autocompletar cliente por CUIT). Certificado de la empresa en AFIP.
# AFIP_CUIT = CUIT del certificado (11 dígitos, sin guiones). Producción: AFIP_PRODUCTION=true
AFIP_CUIT=30123456789
AFIP_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AFIP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
AFIP_PRODUCTION=false
