{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .ts,.js src/",
    "prebuild": "node ../../scripts/build-hours-core.mjs && node ../../scripts/sync-hours-core-to-functions.mjs && node ../../scripts/bundle-hours-ledger.mjs && node ../../scripts/sync-eventuales-to-functions.mjs",
    "build": "tsc && node ../../scripts/copy-hours-ledger-bundle.mjs && node ../../scripts/sync-eventuales-to-functions.mjs --lib",
    "check:standalone": "node ../../scripts/check-functions-standalone.mjs",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@afipsdk/afip.js": "^1.2.3",
    "@cosp/hours-core": "file:./vendor/hours-core",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "arca-cert": "^0.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "googleapis": "^171.4.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "nodemailer": "^8.0.5",
    "pdfkit": "^0.15.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "@types/nodemailer": "^8.0.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "eslint": "^8.42.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.27.5",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
